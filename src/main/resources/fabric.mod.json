{
	"schemaVersion": 1,
	"id": "led",
	"version": "${version}",

	"name": "Light Emitting Diode",
	"description": "A semiconductor that emits light when current flows through it.",

	"icon": "assets/led/icon.png",
	"license": "MIT",
	"contact": {
		"homepage": "http://darktree.net/",
		"sources": "https://github.com/magistermaks/mod-led",
		"issues": "https://github.com/magistermaks/mod-led/issues"
	},

	"environment": "*",
	"entrypoints": {
		"main": [
			"net.darktree.led.LED"
		],
		"client": [
			"net.darktree.led.client.LedClient"
		],
		"fabric-datagen": [
			"net.darktree.led.client.LedDatagen"
		]
	},

	"mixins": [
		"led.mixins.json",
		{
			"config": "led.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
		"fabricloader": ">=0.16.10",
		"fabric": "*",
		"minecraft": ["1.21.6"]
	},

	"suggests": {
		"redbits": "*"
	},

	"authors": [
		"magistermaks"
	],

	"contributors": [
	]
}
